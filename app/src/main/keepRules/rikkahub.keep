# Release builds may shrink and optimize code, but must not rename symbols.
-dontobfuscate

# kotlinx.serialization looks up serializers of @Serializable classes reflectively at runtime.
-keep @kotlinx.serialization.Serializable class * { *; }

# Keep source locations so release stack traces retain useful line information.
-keepattributes SourceFile,LineNumberTable

# Exception class names show up in error messages and logs; keep them readable.
-keepnames class * extends java.lang.Throwable

# Ktor references JVM-only management APIs from its debug detector.
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean

# SnakeYAML's JavaBean introspection references java.beans, which is unavailable on Android.
-dontwarn java.beans.BeanInfo
-dontwarn java.beans.FeatureDescriptor
-dontwarn java.beans.IntrospectionException
-dontwarn java.beans.Introspector
-dontwarn java.beans.PropertyDescriptor

# re2j has optional references that are unavailable on Android.
-dontwarn com.google.re2j.**

# Keep generic signatures and inner class info for libraries that read them reflectively at runtime.
-keepattributes Signature,InnerClasses,EnclosingMethod

# JLatexMath looks up \newcommand macros and the Greek/Cyrillic alphabet registrations by class name.
-keep class org.scilab.forge.jlatexmath.NewCommandMacro {
    <init>();
    java.lang.String executeMacro(org.scilab.forge.jlatexmath.TeXParser, java.lang.String[]);
}
-keep class org.scilab.forge.jlatexmath.cyrillic.CyrillicRegistration { <init>(); }
-keep class org.scilab.forge.jlatexmath.greek.GreekRegistration { <init>(); }

# JSch: SSH client loads crypto providers (com.jcraft.jsch.jce.*) reflectively
-keep class com.jcraft.jsch.** { *; }
-dontwarn com.sun.jna.**
-dontwarn org.apache.logging.log4j.**
-dontwarn org.ietf.jgss.**
-dontwarn org.newsclub.net.unix.**

# LiteRT-LM (com.google.ai.edge.litertlm:litertlm-android): JNI GetMethodID lookups by name
-keep class com.google.ai.edge.litertlm.** { *; }
-keep class com.google.ai.edge.litert.** { *; }

# requery sqlite-android (FTS-enabled SQLite)
-keep class io.requery.android.database.** { *; }
-keepclasseswithmembers class io.requery.android.database.** {
    native <methods>;
}
-keepclassmembers class io.requery.android.database.CursorWindow {
    static int sDefaultCursorWindowSize;
}

# llama.cpp streaming JNI surface
-keep class me.rerere.llamacpp.LlamaCppJni { *; }
-keepclasseswithmembers class me.rerere.llamacpp.LlamaCppJni {
    native <methods>;
}
-keep interface me.rerere.llamacpp.LlamaCppJni$TokenSink { *; }
-keep class * implements me.rerere.llamacpp.LlamaCppJni$TokenSink { *; }

# SLF4J 2.x service-loader binding
-keep class * implements org.slf4j.spi.SLF4JServiceProvider
-keepclassmembers class * implements org.slf4j.spi.SLF4JServiceProvider { <init>(); }
-keep class uk.uuid.slf4j.android.** { *; }

# ML Kit GenAI Prompt (local-llm module)
-keep class com.google.mlkit.** { *; }
-dontwarn com.google.mlkit.**

# Shizuku user service reflective constructor
-keepclassmembers class me.rerere.rikkahub.shizuku.ShizukuUserService {
    public <init>(...);
}

# Optional JVM-only dependencies in OkHttp, Ktor, Pebble, SnakeYAML, Metadata-Extractor, CronUtils
-dontwarn org.yaml.snakeyaml.**
-dontwarn com.drew.**
-dontwarn com.mitchellbosecke.pebble.**
-dontwarn io.ktor.**
-dontwarn okhttp3.**
-dontwarn okio.**
-dontwarn org.apache.commons.**
-dontwarn com.cronutils.**
-dontwarn javax.jmdns.**
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**

# Room DAOs, Entities, and Database subclasses
-keep class * extends androidx.room.RoomDatabase { *; }
-keep interface * extends androidx.room.RoomDatabase { *; }
-keep @androidx.room.Dao interface * { *; }
-keep @androidx.room.Entity class * { *; }

# Koin and ViewModel
-keep class * extends androidx.lifecycle.ViewModel { *; }
